# Export these variables in your shell/service; SnowMail does not auto-load .env.
API_KEY=replace-with-a-long-random-admin-password
API_PORT=8080
API_HOST=0.0.0.0
# Reverse proxy trust policy ('loopback' trusts local Nginx/cloudflared; set 'false' if exposed directly):
TRUST_PROXY=loopback
# Max failed password/key guesses per IP per minute before temporary 429 cooldown (valid keys are never limited):
AUTH_MAX_FAILURES_PER_MIN=15
# false = receive via Amelu only, without listening on SMTP port 25.
SMTP_ENABLED=false
# Used only when SMTP_ENABLED=true:
MAIL_DOMAINS=example.com
SMTP_PORT=25
RETENTION_HOURS=48
AMELU_SYNC_SECONDS=15
# Optional persistent directory containing mail.db and .amelu-key:
# DATA_DIR=/var/lib/snowmail
# Optional 64-hex-character encryption key; otherwise .amelu-key is generated.
# AMELU_SECRET_KEY=
